        height: calc((min(calc(100vw - 30px), calc(100vh - 140px)) - 20px) / 10);
        font-size: 1.5rem;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Panel de Configuracion -->
    <div class="setup-panel" id="setup">
      <div class="setup-title">CONFIGURACION</div>

      <div class="mode-selector">
        <div class="mode-btn" data-mode="coleccion">
          <h3>MODO 1: COLECCION</h3>
          <p>Hay que juntar 4 llantas + 1 llave de un mismo auto. El ÚLTIMO que complete cada set se lleva ese auto.</p>
        </div>
        <div class="mode-btn" data-mode="carrera">
          <h3>MODO 2: CARRERA</h3>
          <p>El PRIMERO en juntar 4 llantas de un auto lo gana. No hay llaves ni casillas especiales.</p>
        </div>
        <div class="mode-btn active" data-mode="caos">
          <h3>MODO 3: CAOS</h3>
          <p>Igual a Carrera, pero con casillas especiales (bomba, robar, intercambiar…) que cambian la partida. Todos los jugadores se llevan algún premio.</p>
        </div>
      </div>

      <div class="prizes-preview">
        <h4>🏆 TODOS GANAN 🏆</h4>
        <div class="prize-list">
          <div class="prize-item aiqar">
            <span class="prize-rank">1</span>
            <img class="prize-car" src="/aiqar-car.png" alt="AIQAR">
            <span class="prize-label">AIQAR</span>
          </div>
          <div class="prize-item byd">
            <span class="prize-rank">2</span>
            <img class="prize-car" src="/byd-car.png" alt="BYD">
            <span class="prize-label">BYD</span>
          </div>
          <div class="prize-item vale">
            <span class="prize-rank">3</span>
            <span class="prize-money">💵</span>
            <span class="prize-amount">10,000 Bs</span>
          </div>
          <div class="prize-item vale">
            <span class="prize-rank">4</span>
            <span class="prize-money">💵</span>
            <span class="prize-amount">8,000 Bs</span>
          </div>
          <div class="prize-item vale">
            <span class="prize-rank">5</span>
            <span class="prize-money">💵</span>
            <span class="prize-amount">6,000 Bs</span>
          </div>
        </div>
      </div>

      <div class="players-preview">
        <h4>JUGADORES</h4>
        <div class="name-list" id="nameList">
          <div class="name-item">
            <div class="name-badge" style="background: #FF6B6B;">1</div>
            <input type="text" maxlength="12" data-player="0" placeholder="Jugador 1">
          </div>
          <div class="name-item">
            <div class="name-badge" style="background: #4ECDC4;">2</div>
            <input type="text" maxlength="12" data-player="1" placeholder="Jugador 2">
          </div>
          <div class="name-item">
            <div class="name-badge" style="background: #FFE66D;">3</div>
            <input type="text" maxlength="12" data-player="2" placeholder="Jugador 3">
          </div>
          <div class="name-item">
            <div class="name-badge" style="background: #95E1D3;">4</div>
            <input type="text" maxlength="12" data-player="3" placeholder="Jugador 4">
          </div>
          <div class="name-item">
            <div class="name-badge" style="background: #DDA0DD;">5</div>
            <input type="text" maxlength="12" data-player="4" placeholder="Jugador 5">
          </div>
        </div>
      </div>

      <button class="btn-start" id="startGame">▶ INICIAR JUEGO</button>
    </div>

    <!-- Area de Juego -->
    <div class="game-area" id="gameArea">
      <div class="game-layout">
        <!-- Sidebar izquierdo con jugadores -->
        <div class="game-sidebar">
          <div class="sidebar-header">
            <span class="turn-arrow">▶</span>
            <div class="current-player-badge">
              <div class="current-player-num" id="currentPlayerBadge">1</div>
            </div>
            <div class="sidebar-buttons">
              <button class="btn-reveal" onclick="confirmRevealAll()">👁</button>
              <button class="btn-restart" onclick="resetGame()">✕</button>
            </div>
          </div>
          <div class="progress-panel" id="progressPanel"></div>
          <div class="players-list" id="playersPanel"></div>
        </div>

        <!-- Tablero con coordenadas -->
        <div class="board-area">
          <div class="alert-box" id="alertBox"></div>

          <!-- Coordenadas columnas (A-J) -->
          <div class="coords-top">
            <div class="coord-cell"></div>
            <div class="coord-cell">A</div>
            <div class="coord-cell">B</div>
            <div class="coord-cell">C</div>
            <div class="coord-cell">D</div>
            <div class="coord-cell">E</div>
            <div class="coord-cell">F</div>
            <div class="coord-cell">G</div>
            <div class="coord-cell">H</div>
            <div class="coord-cell">I</div>
            <div class="coord-cell">J</div>
          </div>

          <div class="board-with-rows">
            <!-- Coordenadas filas (1-10) -->
            <div class="coords-left">
              <div class="coord-cell">1</div>
              <div class="coord-cell">2</div>
              <div class="coord-cell">3</div>
              <div class="coord-cell">4</div>
              <div class="coord-cell">5</div>
              <div class="coord-cell">6</div>
              <div class="coord-cell">7</div>
              <div class="coord-cell">8</div>
              <div class="coord-cell">9</div>
              <div class="coord-cell">10</div>
            </div>

            <div class="board" id="board"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Final -->
  <div class="modal" id="finalModal">
    <div class="modal-content">
      <h2>🏆 RESULTADOS FINALES 🏆</h2>
      <div class="final-results" id="finalResults"></div>
      <button class="btn-start" onclick="resetGame()">JUGAR DE NUEVO</button>
    </div>
  </div>

  <!-- Modal Especial -->
  <div class="modal" id="specialModal">
    <div class="modal-content special-modal">
      <div class="special-icon" id="specialIcon"></div>
      <h3 id="specialTitle"></h3>
      <p id="specialDesc"></p>
      <div class="choice-buttons" id="specialButtons"></div>
    </div>
  </div>

  <!-- Modal Alerta -->
  <div class="modal" id="alertModal">
    <div class="modal-content special-modal">
      <div class="special-icon" id="alertIcon"></div>
      <h3 id="alertTitle"></h3>
      <p id="alertDesc"></p>
      <button class="btn-start" id="alertOk">OK</button>
    </div>
  </div>

  <!-- Modal Confirmar Revelar -->
  <div class="modal" id="confirmRevealModal">
    <div class="modal-content special-modal">
      <div class="special-icon">👁</div>
      <h3>REVELAR TODO</h3>
      <p>Esto mostrara todas las casillas del tablero. El juego continuara normalmente.</p>
      <div class="choice-buttons">
        <button class="choice-btn" onclick="revealAllBoard()">SI, REVELAR</button>
        <button class="choice-btn skip-turn" onclick="closeConfirmReveal()">CANCELAR</button>
      </div>
    </div>
  </div>

  <script>
    // Colores de jugadores
    const PLAYER_COLORS = ['#FF6B6B', '#4ECDC4', '#FFE66D', '#95E1D3', '#DDA0DD'];

    // Tipos especiales
    const SPECIAL_TYPES = [
      { id: 'doble', icon: '🔄', name: 'DOBLE TURNO', desc: '¡Bonus! Vas a abrir otra casilla en este mismo turno.' },
      { id: 'robar', icon: '🏴‍☠️', name: 'ROBAR', desc: 'Elegí a quién robarle 1 llanta. Esa llanta pasa a tu cuenta.' },
      { id: 'revelar2', icon: '👀', name: 'REVELAR 2', desc: '¡Bonus! Vas a poder abrir otra casilla en este mismo turno.' },
      { id: 'bomba', icon: '💣', name: 'BOMBA', desc: '¡Boom! Perdés TODAS las llantas de un tipo (AIQAR o BYD) elegido al azar.' },
      { id: 'comodin', icon: '🃏', name: 'COMODIN', desc: 'Elegí un tipo y sumás 1 llanta de ese tipo a tu cuenta.' },
      { id: 'intercambio', icon: '🔀', name: 'INTERCAMBIO', desc: 'Cambiás TODAS tus llantas (AIQAR y BYD) por las de otro jugador.' },
      { id: 'espejo', icon: '🪞', name: 'ESPEJO', desc: 'Copiás las llantas de otro jugador. Las tuyas se reemplazan por las del elegido.' },
      { id: 'bloqueo', icon: '🚫', name: 'BLOQUEO', desc: 'El próximo jugador en la rueda pierde su turno.' }
    ];

    // Estado del juego
    let gameState = {
      mode: 'caos',
      players: [],
      currentPlayer: 0,
      board: [],
      revealed: [],
      cellOwners: [],
      gameOver: false,
      aiqarWinner: null,
      bydWinner: null,
      // Modo 1: piezas totales encontradas (no importa quién)
      aiqarPiecesFound: 0, // 4 llantas + 1 llave = 5 total
      bydPiecesFound: 0,
      skipNextPlayer: false,
      extraTurn: false,
      revealExtra: false
    };

    // Configuracion
    const CONFIG = {
      boardSize: 10,
      aiqarTires: 14,  // Modo 2/3
      bydTires: 12,    // Modo 2/3
      specialCells: 12
    };

    // Inicializacion
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.mode-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          gameState.mode = btn.dataset.mode;
          updateLegend();
        });
      });

      document.getElementById('startGame').addEventListener('click', startGame);
      document.getElementById('alertOk').addEventListener('click', closeAlertAndContinue);

      // Prellenar inputs de nombre con últimos guardados
      const savedNames = loadSavedNames();
      document.querySelectorAll('#nameList input[data-player]').forEach((input, i) => {
        if (savedNames && savedNames[i]) input.value = savedNames[i];
      });
    });

    function updateLegend() {
      document.querySelectorAll('.legend-key').forEach(el => {
        // Llaves solo en modo 1 (coleccion)
        el.style.display = gameState.mode === 'coleccion' ? 'flex' : 'none';
      });
      document.querySelectorAll('.legend-special').forEach(el => {
        el.style.display = gameState.mode === 'caos' ? 'flex' : 'none';
      });
    }

    function startGame() {
      const nameInputs = document.querySelectorAll('#nameList input[data-player]');
      const names = Array.from(nameInputs).map((input, i) => {
        const v = input.value.trim();
        return v || `Jugador ${i + 1}`;
      });
      saveNames(names);

      gameState.players = PLAYER_COLORS.map((color, i) => ({
        number: i + 1,
        name: names[i],
        aiqar: 0,
        byd: 0,
        keyAiqar: false,
        keyByd: false,
        bricks: 0,
        prize: null,
        protected: false,
        color: color
      }));

      gameState.currentPlayer = 0;
      gameState.gameOver = false;
      gameState.aiqarWinner = null;
      gameState.bydWinner = null;
      gameState.aiqarPiecesFound = 0;
      gameState.bydPiecesFound = 0;
      gameState.skipNextPlayer = false;
      gameState.extraTurn = false;
      gameState.revealExtra = false;
      gameState.winCounter = 0;

      generateBoard();

      document.getElementById('setup').style.display = 'none';
      document.getElementById('gameArea').classList.add('active');
      document.querySelector('.container').classList.add('fullscreen');

      updateLegend();
      renderBoard();
      renderPlayers();
      updateCurrentPlayer();
      updateProgressPanel();
      saveGameState();
    }

    function generateBoard() {
      const totalCells = CONFIG.boardSize * CONFIG.boardSize;

      if (gameState.mode === 'coleccion') {
        gameState.board = generateRiggedBoardMode1(totalCells);
      } else if (gameState.mode === 'carrera') {
        gameState.board = generateRiggedBoardMode2(totalCells);
      } else {
        gameState.board = generateRiggedBoardMode3(totalCells);
      }

      gameState.revealed = new Array(totalCells).fill(false);
      gameState.cellOwners = new Array(totalCells).fill(null);
    }

    // MODO 1: Colección - drama máximo con piezas ganadoras juntas
    function generateRiggedBoardMode1(totalCells) {
      const board = new Array(totalCells).fill('brick');
      const size = CONFIG.boardSize;

      // === ESTRATEGIA: ZONA DE DRAMA ===
      // Las piezas ganadoras (5ta de cada auto) están MUY CERCA entre sí
      // Esto crea tensión: encontrar un área puede dar ambos autos

      // 1. SEÑUELOS: Clusters de 2-3 piezas tempranas para atraer
      //    Van en esquinas/bordes para que busquen ahí primero
      const baitZones = [
        [0, 1, 10, 11],           // Esquina sup-izq
        [8, 9, 18, 19],           // Esquina sup-der
        [80, 81, 90, 91],         // Esquina inf-izq
        [88, 89, 98, 99]          // Esquina inf-der
      ];

      // Colocar señuelos AIQAR (2 llantas en 2 esquinas)
      shuffleArray(baitZones);
      const aiqarBait1 = shuffleArray([...baitZones[0]]);
      const aiqarBait2 = shuffleArray([...baitZones[1]]);
      board[aiqarBait1[0]] = 'aiqar';
      board[aiqarBait1[1]] = 'aiqar';
      board[aiqarBait2[0]] = 'aiqar';

      // Colocar señuelos BYD (2 llantas en otras esquinas)
      const bydBait1 = shuffleArray([...baitZones[2]]);
      const bydBait2 = shuffleArray([...baitZones[3]]);
      board[bydBait1[0]] = 'byd';
      board[bydBait1[1]] = 'byd';
      board[bydBait2[0]] = 'byd';

      // 2. ZONA DE DRAMA CENTRAL: Las piezas ganadoras
      //    La 4ta llanta y llave de AMBOS autos están en un área pequeña del centro
      const centerArea = [44, 45, 54, 55, 34, 35, 43, 46, 53, 56, 64, 65];
      shuffleArray(centerArea);

      // Piezas ganadoras JUNTAS (máximo drama)
      board[centerArea[0]] = 'aiqar';      // 4ta llanta AIQAR
      board[centerArea[1]] = 'key-aiqar';  // Llave AIQAR
      board[centerArea[2]] = 'byd';        // 4ta llanta BYD
      board[centerArea[3]] = 'key-byd';    // Llave BYD

      // 3. LLAVES SEPARADAS: Una llave extra en zona opuesta (más difícil)
      //    No aplica - modo 1 solo tiene 4 llantas + 1 llave por auto

      // 4. Pequeña mezcla para que no sea obvio
      for (let i = 0; i < 8; i++) {
        const a = Math.floor(Math.random() * totalCells);
        const b = Math.floor(Math.random() * totalCells);
        // Solo intercambiar bricks con bricks o items del mismo tipo
        if (board[a] === 'brick' && board[b] === 'brick') {
          // No hacer nada, ya son iguales
        } else if (board[a] === 'brick' || board[b] === 'brick') {
          // Intercambiar solo si no rompe los clusters importantes
          const isImportant = centerArea.slice(0, 4).includes(a) || centerArea.slice(0, 4).includes(b);
          if (!isImportant && Math.random() < 0.3) {
            [board[a], board[b]] = [board[b], board[a]];
          }
        }
      }

      return board;
    }

    // MODO 2: Carrera - clusters intercalados + zona final disputada
    function generateRiggedBoardMode2(totalCells) {
      const board = new Array(totalCells).fill('brick');
      const size = CONFIG.boardSize;

      // === ESTRATEGIA: RACHAS + ZONA FINAL DISPUTADA ===
      // 1. Clusters de 2-3 llantas para crear "rachas" emocionantes
      // 2. La 4ta llanta de AMBOS tipos está en la MISMA zona = carrera final

      // Definir zonas del tablero
      const zones = {
        topLeft: [0,1,2,10,11,12,20,21,22],
        topRight: [7,8,9,17,18,19,27,28,29],
        bottomLeft: [70,71,72,80,81,82,90,91,92],
        bottomRight: [77,78,79,87,88,89,97,98,99],
        center: [33,34,35,36,43,44,45,46,53,54,55,56,63,64,65,66]
      };

      // 1. CLUSTERS INTERCALADOS: AIQAR y BYD comparten zonas
      //    Total: 14 AIQAR + 12 BYD

      // Cluster 1 (top-left): 3 AIQAR + 3 BYD
      let zone = shuffleArray([...zones.topLeft]);
      board[zone[0]] = 'aiqar';
      board[zone[1]] = 'aiqar';
      board[zone[2]] = 'aiqar';
      board[zone[3]] = 'byd';
      board[zone[4]] = 'byd';
      board[zone[5]] = 'byd';

      // Cluster 2 (top-right): 3 AIQAR + 3 BYD
      zone = shuffleArray([...zones.topRight]);
      board[zone[0]] = 'aiqar';
      board[zone[1]] = 'aiqar';
      board[zone[2]] = 'aiqar';
      board[zone[3]] = 'byd';
      board[zone[4]] = 'byd';
      board[zone[5]] = 'byd';

      // Cluster 3 (bottom-left): 2 AIQAR + 2 BYD
      zone = shuffleArray([...zones.bottomLeft]);
      board[zone[0]] = 'aiqar';
      board[zone[1]] = 'aiqar';
      board[zone[2]] = 'byd';
      board[zone[3]] = 'byd';

      // Cluster 4 (bottom-right): 2 AIQAR + 2 BYD
      zone = shuffleArray([...zones.bottomRight]);
      board[zone[0]] = 'aiqar';
      board[zone[1]] = 'aiqar';
      board[zone[2]] = 'byd';
      board[zone[3]] = 'byd';

      // 2. ZONA FINAL DISPUTADA: Las llantas ganadoras en el CENTRO
      zone = shuffleArray([...zones.center]);
      // AIQAR: ya hay 10, faltan 4 para llegar a 14
      board[zone[0]] = 'aiqar';
      board[zone[1]] = 'aiqar';
      board[zone[2]] = 'aiqar';
      board[zone[3]] = 'aiqar';

      // BYD: ya hay 10, faltan 2 para llegar a 12
      board[zone[4]] = 'byd';
      board[zone[5]] = 'byd';

      // 3. DISPERSAR algunas para que no sea tan predecible
      const emptyPositions = board.map((item, i) => item === 'brick' ? i : -1).filter(i => i >= 0);
      shuffleArray(emptyPositions);

      // Mover 2-3 llantas random a posiciones dispersas
      const aiqarPositions = board.map((item, i) => item === 'aiqar' ? i : -1).filter(i => i >= 0);
      const bydPositions = board.map((item, i) => item === 'byd' ? i : -1).filter(i => i >= 0);

      // Intercambiar algunas posiciones para variedad
      for (let i = 0; i < 3 && emptyPositions.length > 0; i++) {
        // Mover una AIQAR aleatoria
        if (aiqarPositions.length > 4) {
          const fromIdx = Math.floor(Math.random() * aiqarPositions.length);
          const from = aiqarPositions[fromIdx];
          const to = emptyPositions.pop();
          board[from] = 'brick';
          board[to] = 'aiqar';
        }
      }

      return board;
    }

    // MODO 3: Caos total - especiales estratégicos
    // Todo se determina al inicio basado en POSICIÓN, no en orden de clicks
    function generateRiggedBoardMode3(totalCells) {
      const board = generateRiggedBoardMode2(totalCells);

      // Identificar zonas del tablero
      const nearTirePositions = []; // Cerca de llantas = CAOS (drama al buscar ganar)
      const farFromTirePositions = []; // Lejos de llantas = REMONTADA (ayuda a quien no encuentra)

      for (let i = 0; i < totalCells; i++) {
        if (board[i] === 'brick') {
          const neighbors = getNeighbors(i);
          const neighbors2 = neighbors.flatMap(n => getNeighbors(n)); // Vecinos de vecinos
          const hasTireNear = neighbors.some(n => board[n] === 'aiqar' || board[n] === 'byd');
          const hasTireFar = neighbors2.some(n => board[n] === 'aiqar' || board[n] === 'byd');

          if (hasTireNear) {
            nearTirePositions.push(i);
          } else if (!hasTireFar) {
            farFromTirePositions.push(i);
          }
        }
      }

      shuffleArray(nearTirePositions);
      shuffleArray(farFromTirePositions);

      // CERCA DE LLANTAS: Caos y bloqueos (drama cuando buscan ganar)
      const chaosSpecials = ['bomba', 'bomba', 'bloqueo', 'bloqueo', 'intercambio'];
      for (let i = 0; i < chaosSpecials.length && nearTirePositions.length > 0; i++) {
        const pos = nearTirePositions.pop();
        board[pos] = 'special-' + chaosSpecials[i];
      }

      // LEJOS DE LLANTAS: Remontada y bonus (ayuda a quien explora sin suerte)
      const helpSpecials = ['robar', 'espejo', 'comodin', 'doble', 'revelar2', 'comodin', 'robar'];
      for (let i = 0; i < helpSpecials.length && farFromTirePositions.length > 0; i++) {
        const pos = farFromTirePositions.pop();
        board[pos] = 'special-' + helpSpecials[i];
      }

      return board;
    }

    function getNeighbors(index) {
      const size = CONFIG.boardSize;
      const row = Math.floor(index / size);
      const col = index % size;
      const neighbors = [];

      if (row > 0) neighbors.push(index - size);
      if (row < size - 1) neighbors.push(index + size);
      if (col > 0) neighbors.push(index - 1);
      if (col < size - 1) neighbors.push(index + 1);

      return neighbors;
    }

    function shuffleArray(array) {
      const arr = [...array];
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    function renderBoard() {
      const board = document.getElementById('board');
      board.innerHTML = '';

      for (let i = 0; i < gameState.board.length; i++) {
        const cell = document.createElement('div');
        cell.className = 'cell';
        cell.dataset.index = i;

        if (gameState.revealed[i]) {
          const itemType = gameState.board[i];
          const type = itemType.split('-')[0];
          cell.classList.add('revealed', type === 'special' ? 'special' : itemType);
          if (gameState.lastRevealed === i) {
            cell.classList.add('just-revealed');
          }

          // Aplicar background directamente a la celda
          applyCellBackground(cell, itemType);

          // Mostrar dueño con borde del color del jugador
          if (gameState.cellOwners[i] !== null) {
            const playerColor = gameState.players[gameState.cellOwners[i]].color;
            cell.style.borderColor = playerColor;
            cell.style.boxShadow = `0 0 8px ${playerColor}, inset 0 0 4px rgba(0,0,0,0.3)`;
          }
        } else {
          cell.innerHTML = '<span class="cell-q">?</span>';
          cell.addEventListener('click', (e) => {
            e.preventDefault();
            if (cell.classList.contains('clicking') || gameState.revealed[i]) return;
            cell.classList.add('clicking');
            setTimeout(() => {
              revealCell(i);
            }, 250);
          });
        }

        board.appendChild(cell);
      }
    }

    function applyCellBackground(cell, type) {
      cell.style.backgroundPosition = 'center';
      cell.style.backgroundRepeat = 'no-repeat';

      if (type === 'aiqar' || type === 'byd') {
        // Llanta nueva con marca del auto integrada
        const logo = document.createElement('img');
        logo.src = type === 'aiqar' ? '/aiqar-tire.png' : '/byd-tire.png';
        logo.style.cssText = 'width:100%;height:100%;object-fit:contain;pointer-events:none;';
        cell.appendChild(logo);
      } else if (type === 'brick') {
        const logo = document.createElement('img');
        logo.src = '/breick-logo.png';
        logo.style.cssText = 'width:100%;height:100%;object-fit:contain;pointer-events:none;';
        cell.appendChild(logo);
      } else if (type === 'key-aiqar' || type === 'key-byd') {
        // Llave con logo del auto
        const logoUrl = type === 'key-aiqar' ? '/aiqar-tire.png' : '/byd-tire.png';
        cell.innerHTML = `
          <div style="width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;">
            <span style="font-size:clamp(16px,6vw,32px);line-height:1;filter:drop-shadow(1px 1px 2px rgba(0,0,0,0.5));">🔑</span>
            <img src="${logoUrl}" style="width:90%;height:auto;max-height:50%;object-fit:contain;">
          </div>
        `;
      } else if (type.startsWith('special-')) {
        const specialId = type.replace('special-', '');
        const special = SPECIAL_TYPES.find(s => s.id === specialId);
        cell.innerHTML = '<span style="font-size:clamp(28px, 9vw, 56px);line-height:1;display:flex;align-items:center;justify-content:center;width:100%;height:100%;">' + (special ? special.icon : '⭐') + '</span>';
      }
    }

    function revealCell(index) {
      if (gameState.revealed[index] || gameState.gameOver) return;

      gameState.revealed[index] = true;
      gameState.cellOwners[index] = gameState.currentPlayer;
      gameState.lastRevealed = index;

      const item = gameState.board[index];
      const player = gameState.players[gameState.currentPlayer];

      // Procesar item
      if (item === 'aiqar') {
        player.aiqar++;
        if (gameState.mode === 'coleccion') {
          gameState.aiqarPiecesFound++;
          checkMode1Alert('aiqar');
        } else {
          // Modo 2/3: Alerta cuando tiene 3 llantas
          checkMode23Alert(player, 'aiqar');
        }
        celebrateTireFound(item, player);
        checkAiqarWin(player, item);
      } else if (item === 'key-aiqar') {
        player.keyAiqar = true;
        if (gameState.mode === 'coleccion') {
          gameState.aiqarPiecesFound++;
          checkMode1Alert('aiqar');
        }
        celebrateTireFound(item, player);
        checkAiqarWin(player, item);
      } else if (item === 'byd') {
        player.byd++;
        if (gameState.mode === 'coleccion') {
          gameState.bydPiecesFound++;
          checkMode1Alert('byd');
        } else {
          // Modo 2/3: Alerta cuando tiene 3 llantas
          checkMode23Alert(player, 'byd');
        }
        celebrateTireFound(item, player);
        checkBydWin(player, item);
      } else if (item === 'key-byd') {
        player.keyByd = true;
        if (gameState.mode === 'coleccion') {
          gameState.bydPiecesFound++;
          checkMode1Alert('byd');
        }
        celebrateTireFound(item, player);
        checkBydWin(player, item);
      } else if (item === 'brick') {
        player.bricks++;
      } else if (item.startsWith('special-')) {
        handleSpecial(item.replace('special-', ''), player);
        return; // Special handles next turn
      }

      updateRevealedCell(index);
      renderPlayers();
      checkAlerts();
      saveGameState();

      // Limpiar last revealed después de la animación
      setTimeout(() => { gameState.lastRevealed = null; }, 600);

      if (!gameState.gameOver) {
        if (gameState.revealExtra) {
          gameState.revealExtra = false;
          // No mostrar alerta - ya se mostró al encontrar el especial
        } else if (gameState.extraTurn) {
          gameState.extraTurn = false;
          // No mostrar alerta - ya se mostró al encontrar el especial
        } else {
          nextTurn();
        }
      }
    }

    function updateRevealedCell(index) {
      const board = document.getElementById('board');
      const cell = board.children[index];
      if (!cell) return;

      const itemType = gameState.board[index];
      const type = itemType.split('-')[0];

      cell.classList.remove('clicking');
      cell.className = 'cell revealed just-revealed' + (type === 'special' ? ' special' : ' ' + itemType);
      cell.innerHTML = '';
      cell.style.borderColor = '';
      cell.style.boxShadow = '';

      applyCellBackground(cell, itemType);

      if (gameState.cellOwners[index] !== null) {
        const playerColor = gameState.players[gameState.cellOwners[index]].color;
        cell.style.borderColor = playerColor;
        cell.style.boxShadow = `0 0 12px ${playerColor}, inset 0 0 4px rgba(0,0,0,0.3)`;
      }

      // Limpiar just-revealed después de la animación para no repetir
      setTimeout(() => cell.classList.remove('just-revealed'), 800);
    }

    function checkMode1Alert(carType) {
      updateProgressPanel();
      if (carType === 'aiqar' && gameState.aiqarPiecesFound === 4 && gameState.aiqarWinner === null) {
        showSmallAlert('⚠️ Proxima pieza AIQAR gana!');
      }
      if (carType === 'byd' && gameState.bydPiecesFound === 4 && gameState.bydWinner === null) {
        showSmallAlert('⚠️ Proxima pieza BYD gana!');
      }
    }

    function checkMode23Alert(player, carType) {
      updateProgressPanel();
      if (carType === 'aiqar' && player.aiqar === 3 && gameState.aiqarWinner === null) {
        showSmallAlert(`⚠️ ${player.name} a 1 llanta de AIQAR!`);
      }
      if (carType === 'byd' && player.byd === 3 && gameState.bydWinner === null) {
        showSmallAlert(`⚠️ ${player.name} a 1 llanta de BYD!`);
      }
    }

    function showSmallAlert(text) {
      const alertBox = document.getElementById('alertBox');
      alertBox.textContent = text;
      alertBox.className = 'alert-box active warning';
      // Auto-ocultar después de 2 segundos
      setTimeout(() => {
        alertBox.className = 'alert-box';
      }, 2000);
    }

    function checkAiqarWin(player, item) {
      if (gameState.aiqarWinner !== null) return; // Ya hay ganador

      if (gameState.mode === 'coleccion') {
        // Modo 1: Quien encuentra la ultima pieza (5ta) gana
        // Ya se incrementó aiqarPiecesFound en revealCell
        if (gameState.aiqarPiecesFound >= 5) {
          gameState.aiqarWinner = gameState.currentPlayer;
          gameState.winCounter = (gameState.winCounter || 0) + 1;
          player.prize = 'AIQAR';
          player.wonAt = gameState.winCounter;
          player.protected = true;
          showAlert('/aiqar-car.png', 'GANADOR AIQAR!', `${player.name} encontro la ultima pieza y gano AIQAR!`);
          checkGameEnd();
        }
      } else {
        // Modo 2 y 3: Solo 4 llantas, PRIMERO gana
        if (player.aiqar >= 4) {
          gameState.aiqarWinner = gameState.currentPlayer;
          gameState.winCounter = (gameState.winCounter || 0) + 1;
          player.prize = 'AIQAR';
          player.wonAt = gameState.winCounter;
          player.protected = true;
          showAlert('/aiqar-car.png', 'GANADOR AIQAR!', `${player.name} gano el AIQAR!`);
          checkGameEnd();
        }
      }
    }

    function checkBydWin(player, item) {
      if (gameState.bydWinner !== null) return; // Ya hay ganador

      if (gameState.mode === 'coleccion') {
        // Modo 1: Quien encuentra la ultima pieza (5ta) gana
        if (gameState.bydPiecesFound >= 5) {
          gameState.bydWinner = gameState.currentPlayer;
          gameState.winCounter = (gameState.winCounter || 0) + 1;
          player.prize = 'BYD';
          player.wonAt = gameState.winCounter;
          player.protected = true;
          showAlert('/byd-car.png', 'GANADOR BYD!', `${player.name} encontro la ultima pieza y gano BYD!`);
          checkGameEnd();
        }
      } else {
        // Modo 2 y 3: Solo 4 llantas, PRIMERO gana
        if (player.byd >= 4) {
          gameState.bydWinner = gameState.currentPlayer;
          gameState.winCounter = (gameState.winCounter || 0) + 1;
          player.prize = 'BYD';
          player.wonAt = gameState.winCounter;
          player.protected = true;
          showAlert('/byd-car.png', 'GANADOR BYD!', `${player.name} gano el BYD!`);
          checkGameEnd();
        }
      }
    }

    function checkGameEnd() {
      // Termina cuando ambos autos tienen ganador
      if (gameState.aiqarWinner !== null && gameState.bydWinner !== null) {
        gameState.gameOver = true;
        clearSavedGame();
        assignVales();
        showFinalResults();
      }
    }

    function assignVales() {
      // Obtener jugadores sin premio (los que no ganaron auto)
      const remaining = gameState.players
        .map((p, i) => ({ ...p, index: i }))
        .filter(p => !p.protected);

      // Ordenar por desempate: mas llantas de un tipo, total llantas, bricks
      remaining.sort((a, b) => {
        const aMax = Math.max(a.aiqar, a.byd);
        const bMax = Math.max(b.aiqar, b.byd);
        if (bMax !== aMax) return bMax - aMax;

        const aTotal = a.aiqar + a.byd;
        const bTotal = b.aiqar + b.byd;
        if (bTotal !== aTotal) return bTotal - aTotal;

        return b.bricks - a.bricks;
      });

      // Asignar vales - TODOS ganan algo
      const vales = ['10,000 Bs', '8,000 Bs', '6,000 Bs', '4,000 Bs', '2,000 Bs'];
      remaining.forEach((p, i) => {
        gameState.players[p.index].prize = vales[i] || '1,000 Bs';
      });

      gameState.gameOver = true;
    }

    function showFinalResults() {
      const results = document.getElementById('finalResults');
      results.innerHTML = '';

      // Conteo de casillas reveladas por jugador (índice en cellOwners)
      const cellsByPlayer = new Array(gameState.players.length).fill(0);
      gameState.cellOwners.forEach(owner => {
        if (owner !== null && owner !== undefined) cellsByPlayer[owner]++;
      });

      // Orden:
      //  1) ganadores de auto primero, en orden cronológico de victoria (wonAt asc)
      //  2) luego el resto, por valor del vale (10k > 8k > 6k > 4k > 2k > 1k)
      const valeRank = (prize) => {
        if (typeof prize !== 'string') return 999;
        const m = prize.match(/(\d[\d,]*)\s*Bs/);
        if (!m) return 999;
        return -parseInt(m[1].replace(/,/g, ''), 10);
      };

      const sorted = [...gameState.players].sort((a, b) => {
        const aCar = a.prize === 'AIQAR' || a.prize === 'BYD';
        const bCar = b.prize === 'AIQAR' || b.prize === 'BYD';
        if (aCar && !bCar) return -1;
        if (!aCar && bCar) return 1;
        if (aCar && bCar) return (a.wonAt || 0) - (b.wonAt || 0);
        return valeRank(a.prize) - valeRank(b.prize);
      });

      sorted.forEach((player, i) => {
        const div = document.createElement('div');
        div.className = `result-item pos-${i + 1}`;
        let prizeHtml = '';
        if (player.prize === 'AIQAR') {
          prizeHtml = `<img src="/aiqar-car.png" alt="AIQAR" style="width:60px;height:42px;object-fit:contain;vertical-align:middle;"> AIQAR`;
        } else if (player.prize === 'BYD') {
          prizeHtml = `<img src="/byd-car.png" alt="BYD" style="width:60px;height:42px;object-fit:contain;vertical-align:middle;"> BYD`;
        } else {
          prizeHtml = `💵 ${player.prize}`;
        }
        const safeName = (player.name || `Jugador ${player.number}`).replace(/</g, '&lt;');
        const playerIdx = gameState.players.indexOf(player);
        const cellsRevealed = cellsByPlayer[playerIdx] || 0;
        div.innerHTML = `
          <div class="result-row-top">
            <div class="result-left">
              <span class="result-position">#${i + 1}</span>
              <span class="result-color" style="background:${player.color};">${player.number}</span>
              <span class="result-name">${safeName}</span>
            </div>
            <div class="result-prize">${prizeHtml}</div>
          </div>
          <div class="result-stats">
            <span class="result-stat" title="Llantas AIQAR encontradas">
              <img src="/aiqar-tire.png" width="22" height="22" style="width:22px;height:22px;object-fit:contain;flex-shrink:0;"> ${player.aiqar}
            </span>
            <span class="result-stat" title="Llantas BYD encontradas">
              <img src="/byd-tire.png" width="22" height="22" style="width:22px;height:22px;object-fit:contain;flex-shrink:0;"> ${player.byd}
            </span>
            <span class="result-stat result-stat-cells" title="Casillas reveladas">
              🎯 ${cellsRevealed}
            </span>
          </div>
        `;
        results.appendChild(div);
      });

      document.getElementById('finalModal').classList.add('active');
    }

    function handleSpecial(type, player) {
      const special = SPECIAL_TYPES.find(s => s.id === type);

      renderBoard();
      renderPlayers();
      saveGameState();

      switch (type) {
        case 'doble':
          gameState.extraTurn = true;
          showAlert(special.icon, special.name, `${player.name}: ${special.desc}`);
          break;

        case 'revelar2':
          gameState.revealExtra = true;
          showAlert(special.icon, special.name, `${player.name}: ${special.desc}`);
          break;

        case 'robar':
          executeRobar(player, special);
          break;

        case 'bomba':
          executeBomba(player, special);
          break;

        case 'comodin':
          showComodinChoice(player, special);
          break;

        case 'intercambio':
          executeIntercambio(player, special);
          break;

        case 'espejo':
          executeEspejo(player, special);
          break;

        case 'bloqueo':
          gameState.skipNextPlayer = true;
          showAlert(special.icon, special.name, 'El próximo jugador en jugar va a perder su turno (lo salteamos).', nextTurn);
          break;
      }
    }

    function getValidTargets() {
      return gameState.players
        .map((p, i) => ({ ...p, index: i }))
        .filter(p => !p.protected && p.index !== gameState.currentPlayer);
    }

    function renderTireBadges(aiqar, byd, size = 22) {
      return `
        <span class="tire-badge tire-aiqar" title="Llantas AIQAR">
          <img src="/aiqar-tire.png" width="${size}" height="${size}" style="width:${size}px;height:${size}px;flex-shrink:0;object-fit:contain;"> ${aiqar}
        </span>
        <span class="tire-badge tire-byd" title="Llantas BYD">
          <img src="/byd-tire.png" width="${size}" height="${size}" style="width:${size}px;height:${size}px;flex-shrink:0;object-fit:contain;"> ${byd}
        </span>
      `;
    }

    function renderActivePlayerHeader() {
      const player = gameState.players[gameState.currentPlayer];
      const safeName = (player.name || `Jugador ${player.number}`).replace(/</g, '&lt;');
      return `
        <div class="active-player-header" style="border-color:${player.color};">
          <span class="active-player-label">TU TURNO</span>
          <div class="active-player-row">
            <span class="active-player-badge" style="background:${player.color};">${player.number}</span>
            <span class="active-player-name">${safeName}</span>
          </div>
          <div class="active-player-tires">${renderTireBadges(player.aiqar, player.byd, 24)}</div>
        </div>
      `;
    }

    function renderTargetButton(target, onclickAttr) {
      const safeName = (target.name || `Jugador ${target.number}`).replace(/</g, '&lt;');
      return `
        <button class="choice-btn target-btn" style="background:${target.color}; --player-color:${target.color};" ${onclickAttr}>
          <span class="target-name-row">
            <span class="target-badge" style="background:${target.color};">${target.number}</span>
            <span class="target-name">${safeName}</span>
          </span>
          <span class="target-tires">${renderTireBadges(target.aiqar, target.byd, 22)}</span>
        </button>
      `;
    }

    function executeRobar(player, special) {
      const targets = getValidTargets().filter(p => p.aiqar > 0 || p.byd > 0);

      if (targets.length === 0) {
        showAlert(special.icon, special.name, 'Nadie tiene llantas que puedas robar.', nextTurn);
        return;
      }

      openTargetModal({
        icon: special.icon,
        title: special.name,
        desc: 'Vas a robarle 1 llanta a otro jugador (esa llanta pasa a tu cuenta). Elegí a quién:',
        targets,
        onclickFn: 'selectRobarTarget'
      });
    }

    window.selectRobarTarget = function(targetIndex) {
      const targetPlayer = gameState.players[targetIndex];
      const types = [];
      if (targetPlayer.aiqar > 0) types.push('aiqar');
      if (targetPlayer.byd > 0) types.push('byd');

      // Si solo tiene un tipo, robar directamente
      if (types.length === 1) {
        window.applyRobar(targetIndex, types[0]);
        return;
      }

      // Mostrar selección de tipo de llanta
      const safeName = (targetPlayer.name || `Jugador ${targetPlayer.number}`).replace(/</g, '&lt;');
      document.getElementById('specialDesc').textContent = `${safeName} tiene 2 tipos de llantas. ¿Cuál querés robarle?`;
      const buttons = document.getElementById('specialButtons');
      buttons.innerHTML = renderActivePlayerHeader() + `
        <div class="targets-grid">
          <button class="choice-btn tire-choice aiqar" onclick="applyRobar(${targetIndex}, 'aiqar')">
            <img src="/aiqar-tire.png" width="48" height="48" style="width:48px;height:48px;object-fit:contain;flex-shrink:0;"> AIQAR<br><small>(le quedan ${targetPlayer.aiqar})</small>
          </button>
          <button class="choice-btn tire-choice byd" onclick="applyRobar(${targetIndex}, 'byd')">
            <img src="/byd-tire.png" width="48" height="48" style="width:48px;height:48px;object-fit:contain;flex-shrink:0;"> BYD<br><small>(le quedan ${targetPlayer.byd})</small>
          </button>
        </div>
      `;
    };

    window.applyRobar = function(targetIndex, type) {
      document.getElementById('specialModal').classList.remove('active');
      const player = gameState.players[gameState.currentPlayer];
      const targetPlayer = gameState.players[targetIndex];

      targetPlayer[type]--;
      player[type]++;

      renderPlayers();
      saveGameState();

      // Verificar si gano
      if (type === 'aiqar') checkAiqarWin(player, 'aiqar');
      else checkBydWin(player, 'byd');

      showAlert('🏴‍☠️', 'ROBO EXITOSO', `${player.name} le robó 1 llanta ${type.toUpperCase()} a ${targetPlayer.name}.`, () => {
        if (!gameState.gameOver) nextTurn();
      });
    };

    function executeBomba(player, special) {
      const types = [];
      if (player.aiqar > 0) types.push('aiqar');
      if (player.byd > 0) types.push('byd');

      if (types.length === 0) {
        showAlert(special.icon, special.name, `${player.name}, no tenías llantas, así que la bomba no te quitó nada. ¡Suerte!`, nextTurn);
        return;
      }

      const type = types[Math.floor(Math.random() * types.length)];
      const lost = player[type];
      player[type] = 0;

      renderPlayers();
      showAlert(special.icon, special.name, `${player.name} perdió ${lost} llanta${lost === 1 ? '' : 's'} ${type.toUpperCase()}.`, nextTurn);
    }

    function showComodinChoice(player, special) {
      const modal = document.getElementById('specialModal');
      document.getElementById('specialIcon').textContent = special.icon;
      document.getElementById('specialTitle').textContent = special.name;
      document.getElementById('specialDesc').textContent = 'Sumás 1 llanta del tipo que elijas. ¿Cuál querés?';

      const buttons = document.getElementById('specialButtons');
      buttons.innerHTML = renderActivePlayerHeader() + `
        <div class="targets-grid">
          <button class="choice-btn tire-choice aiqar" onclick="applyComodin('aiqar')">
            <img src="/aiqar-tire.png" width="48" height="48" style="width:48px;height:48px;object-fit:contain;flex-shrink:0;"> AIQAR<br><small>(+1 llanta AIQAR)</small>
          </button>
          <button class="choice-btn tire-choice byd" onclick="applyComodin('byd')">
            <img src="/byd-tire.png" width="48" height="48" style="width:48px;height:48px;object-fit:contain;flex-shrink:0;"> BYD<br><small>(+1 llanta BYD)</small>
          </button>
        </div>
      `;

      modal.classList.add('active');
    }

    window.applyComodin = function(type) {
      document.getElementById('specialModal').classList.remove('active');
      const player = gameState.players[gameState.currentPlayer];
      player[type]++;

      renderPlayers();

      if (type === 'aiqar') checkAiqarWin(player, 'aiqar');
      else checkBydWin(player, 'byd');

      if (!gameState.gameOver) nextTurn();
    };

    function executeIntercambio(player, special) {
      const targets = getValidTargets();

      if (targets.length === 0) {
        showAlert(special.icon, special.name, 'No hay con quien intercambiar!', nextTurn);
        return;
      }

      openTargetModal({
        icon: special.icon,
        title: special.name,
        desc: 'Vas a cambiar TODAS tus llantas (AIQAR y BYD) por las del jugador que elijas. Elegí con quién intercambiar:',
        targets,
        onclickFn: 'applyIntercambio'
      });
    }

    window.applyIntercambio = function(targetIndex) {
      document.getElementById('specialModal').classList.remove('active');
      const player = gameState.players[gameState.currentPlayer];
      const targetPlayer = gameState.players[targetIndex];

      // Intercambiar
      const tempAiqar = player.aiqar;
      const tempByd = player.byd;
      player.aiqar = targetPlayer.aiqar;
      player.byd = targetPlayer.byd;
      targetPlayer.aiqar = tempAiqar;
      targetPlayer.byd = tempByd;

      renderPlayers();
      saveGameState();

      // Verificar si alguien gano
      checkAiqarWin(player, 'aiqar');
      checkBydWin(player, 'byd');

      showAlert('🔀', 'INTERCAMBIO', `${player.name} cambió todas sus llantas con ${targetPlayer.name}.`, () => {
        if (!gameState.gameOver) nextTurn();
      });
    };

    function executeEspejo(player, special) {
      const targets = getValidTargets();

      if (targets.length === 0) {
        showAlert(special.icon, special.name, 'No hay a quien copiar!', nextTurn);
        return;
      }

      openTargetModal({
        icon: special.icon,
        title: special.name,
        desc: 'Tus llantas se reemplazan por las del jugador que elijas (te quedás con la misma cantidad que él). Elegí a quién copiar:',
        targets,
        onclickFn: 'applyEspejo'
      });
    }

    function openTargetModal({ icon, title, desc, targets, onclickFn }) {
      const modal = document.getElementById('specialModal');
      document.getElementById('specialIcon').textContent = icon;
      document.getElementById('specialTitle').textContent = title;
      document.getElementById('specialDesc').textContent = desc;

      const buttons = document.getElementById('specialButtons');
      const headerHtml = renderActivePlayerHeader();
      const targetsHtml = targets.map(t => renderTargetButton(t, `onclick="${onclickFn}(${t.index})"`)).join('');
      buttons.innerHTML = headerHtml + '<div class="targets-grid">' + targetsHtml + '</div>';

      modal.classList.add('active');
    }

    window.applyEspejo = function(targetIndex) {
      document.getElementById('specialModal').classList.remove('active');
      const player = gameState.players[gameState.currentPlayer];
      const targetPlayer = gameState.players[targetIndex];

      player.aiqar = targetPlayer.aiqar;
      player.byd = targetPlayer.byd;

      renderPlayers();
      saveGameState();

      checkAiqarWin(player, 'aiqar');
      checkBydWin(player, 'byd');

      showAlert('🪞', 'ESPEJO', `${player.name} copió las llantas de ${targetPlayer.name} (ahora tiene las mismas cantidades).`, () => {
        if (!gameState.gameOver) nextTurn();
      });
    };

    let alertCallback = null;

    function showAlert(icon, title, desc, callback = null) {
      const alertIcon = document.getElementById('alertIcon');
      const alertModal = document.getElementById('alertModal');
      const modalContent = alertModal.querySelector('.modal-content');
      const isCarWin = typeof icon === 'string' && icon.startsWith('/') && icon.includes('-car.png');

      if (typeof icon === 'string' && icon.startsWith('/')) {
        alertIcon.innerHTML = `<img src="${icon}" alt="" style="width:min(180px, 40vmin);height:auto;max-height:min(180px, 40vmin);object-fit:contain;display:block;margin:0 auto;">`;
      } else {
        alertIcon.textContent = icon;
      }
      document.getElementById('alertTitle').textContent = title;
      document.getElementById('alertDesc').textContent = desc;
      alertModal.classList.add('active');
      alertCallback = callback;

      modalContent.classList.remove('alert-celebrate');
      if (isCarWin) {
        void modalContent.offsetWidth;
        modalContent.classList.add('alert-celebrate');
        launchConfetti();
      }
    }

    function launchConfetti() {
      const container = document.createElement('div');
      container.className = 'confetti-container';
      const colors = ['#FFB81C', '#00BFFF', '#FF4500', '#00FF88', '#DDA0DD', '#FFE66D'];
      const pieces = 90;
      for (let i = 0; i < pieces; i++) {
        const piece = document.createElement('div');
        piece.className = 'confetti-piece';
        piece.style.left = Math.random() * 100 + '%';
        piece.style.background = colors[Math.floor(Math.random() * colors.length)];
        piece.style.animationDuration = (2 + Math.random() * 2) + 's';
        piece.style.animationDelay = (Math.random() * 0.4) + 's';
        piece.style.transform = `rotate(${Math.random() * 360}deg)`;
        if (Math.random() > 0.5) piece.style.borderRadius = '50%';
        container.appendChild(piece);
      }
      document.body.appendChild(container);
      setTimeout(() => container.remove(), 4500);
    }

    function launchStars(tint) {
      const container = document.createElement('div');
      container.className = 'fx-container';
      const count = 60;
      const colors = tint ? [tint, '#FFD700', '#FFFFFF'] : ['#FFD700', '#FFFFFF', '#FFB81C', '#FFE66D'];
      for (let i = 0; i < count; i++) {
        const star = document.createElement('div');
        star.className = 'fx-star';
        star.textContent = '⭐';
        const startLeft = Math.random() * 100;
        const startTop = Math.random() * 60;
        const drift = (Math.random() - 0.5) * 40;
        const size = 0.8 + Math.random() * 1.6;
        const dur = 1.4 + Math.random() * 1.4;
        const delay = Math.random() * 0.5;
        star.style.left = startLeft + '%';
        star.style.top = startTop + '%';
        star.style.fontSize = size + 'rem';
        star.style.color = colors[i % colors.length];
        star.style.setProperty('--drift', drift + 'vw');
        star.style.animationDuration = dur + 's';
        star.style.animationDelay = delay + 's';
        container.appendChild(star);
      }
      document.body.appendChild(container);
      setTimeout(() => container.remove(), 3500);
    }

    function launchCarsWarning(carType, playerName) {
      const container = document.createElement('div');
      container.className = 'fx-container fx-cars';
      const carSrc = carType === 'aiqar' ? '/aiqar-car.png' : '/byd-car.png';
      const tint = carType === 'aiqar' ? '#00BFFF' : '#FF4500';

      const banner = document.createElement('div');
      banner.className = 'fx-warning-banner';
      banner.style.color = tint;
      banner.style.borderColor = tint;
      banner.style.boxShadow = `0 0 30px ${tint}, inset 0 0 16px ${tint}80`;
      banner.innerHTML = `<span class="fx-warning-icon">⚠️</span>
        <span class="fx-warning-text">¡${playerName} está a 1 llanta ${carType.toUpperCase()} de ganar!</span>
        <span class="fx-warning-icon">⚠️</span>`;
      container.appendChild(banner);

      const count = 10;
      for (let i = 0; i < count; i++) {
        const car = document.createElement('img');
        car.className = 'fx-car';
        car.src = carSrc;
        const fromLeft = Math.random() > 0.5;
        const topPct = 10 + Math.random() * 75;
        const dur = 2.2 + Math.random() * 1.8;
        const delay = Math.random() * 1.5;
        const scale = 0.7 + Math.random() * 1.1;
        car.style.top = topPct + '%';
        car.style.animationDuration = dur + 's';
        car.style.animationDelay = delay + 's';
        car.style.setProperty('--car-scale', scale);
        if (fromLeft) {
          car.classList.add('fx-car-ltr');
        } else {
          car.classList.add('fx-car-rtl');
        }
        container.appendChild(car);
      }

      document.body.appendChild(container);
      setTimeout(() => container.remove(), 5800);
    }

    function celebrateTireFound(itemType, player) {
      const isAiqar = itemType === 'aiqar' || itemType === 'key-aiqar';
      const isByd = itemType === 'byd' || itemType === 'key-byd';
      if (!isAiqar && !isByd) return;

      const type = isAiqar ? 'aiqar' : 'byd';
      const tint = isAiqar ? '#00BFFF' : '#FF4500';

      let aboutToWin = false;
      if (gameState.mode === 'coleccion') {
        const found = isAiqar ? gameState.aiqarPiecesFound : gameState.bydPiecesFound;
        const winner = isAiqar ? gameState.aiqarWinner : gameState.bydWinner;
        // 4 piezas encontradas y nadie ganó aún → la próxima gana
        aboutToWin = found === 4 && winner === null;
      } else {
        const winner = isAiqar ? gameState.aiqarWinner : gameState.bydWinner;
        // jugador llegó a 3, le falta 1
        aboutToWin = player[type] === 3 && winner === null;
      }

      if (aboutToWin) {
        launchCarsWarning(type, player.name);
      } else {
        launchStars(tint);
      }
    }

    function closeAlertAndContinue() {
      document.getElementById('alertModal').classList.remove('active');
      if (alertCallback) {
        const cb = alertCallback;
        alertCallback = null;
        cb();
      }
    }

    function checkAlerts() {
      // Solo actualizar panel de progreso - las alertas temporales se manejan aparte
      updateProgressPanel();
    }

    function updateProgressPanel() {
      const panel = document.getElementById('progressPanel');
      if (!panel) return;

      let html = '';

      if (gameState.mode === 'coleccion') {
        // Modo 1: Mostrar progreso de piezas
        const aiqarWon = gameState.aiqarWinner !== null;
        const bydWon = gameState.bydWinner !== null;
        const aiqarWarning = gameState.aiqarPiecesFound === 4 && !aiqarWon;
        const bydWarning = gameState.bydPiecesFound === 4 && !bydWon;

        html += `<div class="progress-item aiqar-prog ${aiqarWon ? 'winner' : ''} ${aiqarWarning ? 'warning' : ''}">`;
        html += `<img src="/aiqar-tire.png" style="width:18px;height:18px;object-fit:contain;vertical-align:middle;"> `;
        if (aiqarWon) {
          html += `🏆 ${gameState.players[gameState.aiqarWinner].name}`;
        } else {
          html += `${gameState.aiqarPiecesFound}/5`;
        }
        html += `</div>`;

        html += `<div class="progress-item byd-prog ${bydWon ? 'winner' : ''} ${bydWarning ? 'warning' : ''}">`;
        html += `<img src="/byd-tire.png" style="width:18px;height:18px;object-fit:contain;vertical-align:middle;"> `;
        if (bydWon) {
          html += `🏆 ${gameState.players[gameState.bydWinner].name}`;
        } else {
          html += `${gameState.bydPiecesFound}/5`;
        }
        html += `</div>`;
      } else {
        // Modo 2 y 3: Solo mostrar cuando alguien está cerca (3/4) o ganó
        // AIQAR
        if (gameState.aiqarWinner !== null) {
          html += `<div class="progress-item aiqar-prog winner"><img src="/aiqar-tire.png" style="width:18px;height:18px;object-fit:contain;vertical-align:middle;"> 🏆 ${gameState.players[gameState.aiqarWinner].name}</div>`;
        } else {
          const maxAiqar = Math.max(...gameState.players.map(p => p.aiqar));
          if (maxAiqar >= 3) {
            const leader = gameState.players.find(p => p.aiqar === maxAiqar);
            html += `<div class="progress-item aiqar-prog warning"><img src="/aiqar-tire.png" style="width:18px;height:18px;object-fit:contain;vertical-align:middle;"> ⚠️ ${leader.name}: ${maxAiqar}/4</div>`;
          }
        }
        // BYD
        if (gameState.bydWinner !== null) {
          html += `<div class="progress-item byd-prog winner"><img src="/byd-tire.png" style="width:18px;height:18px;object-fit:contain;vertical-align:middle;"> 🏆 ${gameState.players[gameState.bydWinner].name}</div>`;
        } else {
          const maxByd = Math.max(...gameState.players.map(p => p.byd));
          if (maxByd >= 3) {
            const leader = gameState.players.find(p => p.byd === maxByd);
            html += `<div class="progress-item byd-prog warning"><img src="/byd-tire.png" style="width:18px;height:18px;object-fit:contain;vertical-align:middle;"> ⚠️ ${leader.name}: ${maxByd}/4</div>`;
          }
        }
      }

      panel.innerHTML = html;
    }

    function nextTurn() {
      if (gameState.gameOver) return;

      const total = gameState.players.length;

      // Si todos están protegidos (ya ganaron), no avanzamos
      if (gameState.players.every(p => p.protected)) return;

      gameState.currentPlayer = (gameState.currentPlayer + 1) % total;

      // Saltar a jugadores que ya ganaron antes de aplicar cualquier bloqueo
      let safety = total;
      while (gameState.players[gameState.currentPlayer].protected && safety-- > 0) {
        gameState.currentPlayer = (gameState.currentPlayer + 1) % total;
      }

      // Aplicar bloqueo sobre el próximo jugador activo (que aún no ganó)
      if (gameState.skipNextPlayer) {
        gameState.skipNextPlayer = false;
        const skipped = gameState.players[gameState.currentPlayer];
        showAlert('🚫', 'TURNO PERDIDO', `${skipped.name} pierde su turno!`);
        gameState.currentPlayer = (gameState.currentPlayer + 1) % total;
        safety = total;
        while (gameState.players[gameState.currentPlayer].protected && safety-- > 0) {
          gameState.currentPlayer = (gameState.currentPlayer + 1) % total;
        }
      }

      updateCurrentPlayer();
      renderPlayers();
      saveGameState();
    }

    function updateCurrentPlayer() {
      const badge = document.getElementById('currentPlayerBadge');
      const player = gameState.players[gameState.currentPlayer];
      badge.textContent = player.number;
      badge.style.background = player.color;

      // Cambiar borde del tablero al color del jugador
      const board = document.getElementById('board');
      board.style.borderColor = player.color;
      board.style.boxShadow = `0 0 30px ${player.color}80`;
    }

    const prevPlayerStats = new Map();

    function renderPlayers() {
      const panel = document.getElementById('playersPanel');
      const needsBuild = panel.children.length !== gameState.players.length;

      if (needsBuild) {
        panel.innerHTML = '';
        prevPlayerStats.clear();
        gameState.players.forEach((player, i) => {
          const card = document.createElement('div');
          card.className = 'player-card';
          card.dataset.idx = String(i);
          const safeName = (player.name || `Jugador ${player.number}`).replace(/</g, '&lt;');
          card.innerHTML = `
            <div class="player-number" style="background:${player.color};">${player.number}</div>
            <div class="player-info">
              <div class="player-name" title="${safeName}">${safeName}</div>
              <div class="player-stats">
                <div class="stat-row aiqar-row" data-stat="aiqar">
                  <img src="/aiqar-tire.png" width="20" height="20" style="width:20px;height:20px;flex-shrink:0;object-fit:contain;">
                  <span class="stat-num">${player.aiqar}</span>
                </div>
                <div class="stat-row byd-row" data-stat="byd">
                  <img src="/byd-tire.png" width="20" height="20" style="width:20px;height:20px;flex-shrink:0;object-fit:contain;">
                  <span class="stat-num">${player.byd}</span>
                </div>
              </div>
            </div>
            <div class="player-prize-slot"></div>
          `;
          panel.appendChild(card);
        });
      }

      gameState.players.forEach((player, i) => {
        const card = panel.children[i];
        if (!card) return;

        let cardClass = 'player-card';
        const isActive = i === gameState.currentPlayer && !player.protected;
        if (isActive) cardClass += ' active';
        if (player.prize === 'AIQAR') cardClass += ' winner-aiqar';
        else if (player.prize === 'BYD') cardClass += ' winner-byd';
        else if (player.prize) cardClass += ' winner-vale';
        card.className = cardClass;

        if (isActive) {
          card.style.borderLeftColor = player.color;
          card.style.borderLeftWidth = '6px';
          card.style.background = `linear-gradient(90deg, ${player.color}66, ${player.color}1a 70%, rgba(0,0,0,0.25))`;
          card.style.boxShadow = `0 0 0 2px ${player.color}cc, 0 0 18px ${player.color}80, inset 0 0 14px ${player.color}33`;
          card.style.color = player.color;
          card.style.transform = 'translateX(4px) scale(1.02)';
          card.style.zIndex = '2';
        } else {
          card.style.borderLeftColor = '';
          card.style.borderLeftWidth = '';
          card.style.background = '';
          card.style.boxShadow = '';
          card.style.color = '';
          card.style.transform = '';
          card.style.zIndex = '';
        }

        const prev = prevPlayerStats.get(i) || { aiqar: player.aiqar, byd: player.byd };

        const aiqarRow = card.querySelector('.stat-row.aiqar-row');
        const bydRow = card.querySelector('.stat-row.byd-row');
        const aiqarNum = aiqarRow.querySelector('.stat-num');
        const bydNum = bydRow.querySelector('.stat-num');

        if (aiqarNum.textContent !== String(player.aiqar)) {
          aiqarNum.textContent = player.aiqar;
          if (!needsBuild && player.aiqar > prev.aiqar) bumpStat(aiqarRow);
        }
        if (bydNum.textContent !== String(player.byd)) {
          bydNum.textContent = player.byd;
          if (!needsBuild && player.byd > prev.byd) bumpStat(bydRow);
        }

        prevPlayerStats.set(i, { aiqar: player.aiqar, byd: player.byd });

        const prizeSlot = card.querySelector('.player-prize-slot');
        if (player.prize === 'AIQAR') {
          prizeSlot.innerHTML = `<img src="/aiqar-car.png" alt="AIQAR" class="prize-car">`;
        } else if (player.prize === 'BYD') {
          prizeSlot.innerHTML = `<img src="/byd-car.png" alt="BYD" class="prize-car">`;
        } else if (player.prize) {
          prizeSlot.innerHTML = `<span class="prize-trophy">🏆</span>`;
        } else {
          prizeSlot.innerHTML = '';
        }
      });
    }

    function bumpStat(row) {
      row.classList.remove('bump');
      void row.offsetWidth;
      row.classList.add('bump');
      setTimeout(() => row.classList.remove('bump'), 600);
    }

    // Estado para saber si el tablero está revelado
    let boardPreviewMode = false;

    window.confirmRevealAll = function() {
      if (boardPreviewMode) {
        // Si ya está revelado, ocultar sin confirmación
        hideAllBoard();
      } else {
        document.getElementById('confirmRevealModal').classList.add('active');
      }
    };

    window.closeConfirmReveal = function() {
      document.getElementById('confirmRevealModal').classList.remove('active');
    };

    window.revealAllBoard = function() {
      document.getElementById('confirmRevealModal').classList.remove('active');
      boardPreviewMode = true;

      // Cambiar icono del botón
      document.querySelector('.btn-reveal').textContent = '🙈';

      // Mostrar todas las casillas con animación
      const board = document.getElementById('board');
      const cells = board.querySelectorAll('.cell');

      cells.forEach((cell, i) => {
        if (!gameState.revealed[i]) {
          // Animación escalonada
          setTimeout(() => {
            const itemType = gameState.board[i];
            const type = itemType.split('-')[0];

            // Animación de volteo
            cell.style.transform = 'rotateY(90deg)';

            setTimeout(() => {
              cell.classList.add('preview-revealed', type === 'special' ? 'special' : itemType);
              cell.innerHTML = '';
              applyCellBackground(cell, itemType);
              cell.style.opacity = '0.7';
              cell.style.border = '2px dashed #fff';
              cell.style.transform = 'rotateY(0deg)';
            }, 150);
          }, i * 30);
        }
      });
    };

    function hideAllBoard() {
      boardPreviewMode = false;

      // Cambiar icono del botón
      document.querySelector('.btn-reveal').textContent = '👁';

      // Ocultar casillas no jugadas con animación
      const board = document.getElementById('board');
      const cells = board.querySelectorAll('.cell');

      cells.forEach((cell, i) => {
        if (!gameState.revealed[i]) {
          setTimeout(() => {
            cell.style.transform = 'rotateY(90deg)';

            setTimeout(() => {
              // Quitar clases y estilos de preview
              cell.className = 'cell';
              cell.style.opacity = '';
              cell.style.border = '';
              cell.style.background = '';
              cell.style.backgroundImage = '';
              cell.style.backgroundSize = '';
              cell.style.backgroundPosition = '';
              cell.style.backgroundRepeat = '';
              cell.innerHTML = '<span style="font-size:clamp(16px, 5vw, 32px);color:#FFD700;text-shadow:0 0 10px #FFB81C, 2px 2px 0 #4A1F56;font-weight:bold;display:flex;align-items:center;justify-content:center;width:100%;height:100%;">?</span>';
              cell.style.transform = 'rotateY(0deg)';
            }, 150);
          }, i * 20);
        }
      });
    }

    window.resetGame = function() {
      boardPreviewMode = false;
      document.getElementById('finalModal').classList.remove('active');
      document.getElementById('specialModal').classList.remove('active');
      document.getElementById('alertModal').classList.remove('active');
      document.getElementById('confirmRevealModal').classList.remove('active');
      document.getElementById('gameArea').classList.remove('active');
      document.querySelector('.container').classList.remove('fullscreen');
      document.getElementById('setup').style.display = 'block';
      const revealBtn = document.querySelector('.btn-reveal');
      if (revealBtn) revealBtn.textContent = '👁';
      clearSavedGame();
    };

    // === PERSISTENCIA DEL JUEGO ===
    const STORAGE_KEY = 'juegoLlantasState';
    const NAMES_KEY = 'juegoLlantasNames';

    function saveNames(names) {
      try { localStorage.setItem(NAMES_KEY, JSON.stringify(names)); } catch (e) {}
    }

    function loadSavedNames() {
      try {
        const raw = localStorage.getItem(NAMES_KEY);
        return raw ? JSON.parse(raw) : null;
      } catch (e) { return null; }
    }

    function saveGameState() {
      const state = {
        gameState: gameState,
        boardPreviewMode: boardPreviewMode,
        timestamp: Date.now()
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    }

    function loadSavedGame() {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (!saved) return null;
      try {
        return JSON.parse(saved);
      } catch (e) {
        return null;
      }
    }

    function clearSavedGame() {
      localStorage.removeItem(STORAGE_KEY);
    }

    function restoreGame(saved) {
      gameState = saved.gameState;
      boardPreviewMode = saved.boardPreviewMode || false;

      document.getElementById('setup').style.display = 'none';
      document.getElementById('gameArea').classList.add('active');
      document.querySelector('.container').classList.add('fullscreen');

      updateLegend();
      renderBoard();
      renderPlayers();
      updateCurrentPlayer();
      updateProgressPanel();
    }

    // Preguntar antes de salir si hay juego en progreso
    window.addEventListener('beforeunload', (e) => {
      if (gameState.players.length > 0 && !gameState.gameOver) {
        saveGameState();
        e.preventDefault();
        e.returnValue = '';
      }
    });

    // Verificar al cargar si hay juego guardado
    window.addEventListener('load', () => {
      const saved = loadSavedGame();
      if (saved && saved.gameState.players.length > 0 && !saved.gameState.gameOver) {
        if (confirm('Hay un juego en progreso guardado. ¿Deseas continuar donde lo dejaste?')) {
          restoreGame(saved);
        } else {
          clearSavedGame();
        }
      }
    });
  </script>
</body>
</html>
